{
  "manifest_version": 3,
  "name": "ContextBridge",
  "version": "0.1.0",
  "description": "Save and transfer AI conversation context across ChatGPT, Claude, Gemini, and Grok.",
  "permissions": ["activeTab", "storage", "scripting", "cookies"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://grok.com/*",
    "https://context-bridge-blue.vercel.app/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "ContextBridge",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://grok.com/*"
      ],
      "js": ["content/content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background/background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "128": "icons/icon128.png"
  }
}
